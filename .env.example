# Copy to .env.local (never commit real values).

# PostgreSQL connection string: local, or Neon (console > Connect > pooled connection).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: real PostgreSQL used by `npm test` to validate migrations. The database is WIPED,
# so its name must end in "_test". Skipped when unset.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/devtrack_test
